# Salin menjadi .env lalu sesuaikan nilainya. Jangan commit berkas .env.

# Koneksi PostgreSQL. `pnpm db:start` menjalankan PostgreSQL khusus proyek ini
# memakai user, password, port, dan nama database dari URL berikut.
DATABASE_URL=postgres://stai:ganti_password_ini@127.0.0.1:5433/stai_morowali

# Kunci rahasia Payload (minimal 32 karakter acak), contoh: openssl rand -hex 32
PAYLOAD_SECRET=ganti_dengan_string_acak_panjang

# URL publik situs tanpa "/" di akhir. Dipakai untuk SEO, sitemap, Open Graph, dan
# proteksi CSRF di produksi. Nilainya ikut tertanam saat build, jadi set sebelum `pnpm build`.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Akun admin pertama yang dibuat `pnpm seed` / `pnpm seed:admin`. Bila password
# kosong, `pnpm seed` membuat password acak dan menampilkannya di terminal
# (`pnpm seed:admin` mewajibkan password). Ganti password setelah login pertama.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@staimorowali.ac.id
SEED_ADMIN_PASSWORD=

# Header berisi IP asli pengunjung yang diisi reverse proxy, untuk pembatas laju
# formulir. Nginx: `proxy_set_header X-Real-IP $remote_addr;` (bawaan x-real-ip).
# Di belakang Cloudflare gunakan cf-connecting-ip.
# TRUSTED_IP_HEADER=x-real-ip

# (Opsional, hanya untuk docker compose service `db`) — samakan dengan password di DATABASE_URL.
# POSTGRES_PASSWORD=ganti_password_ini
